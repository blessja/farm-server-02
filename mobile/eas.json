{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://farm-server-02.onrender.com",
        "EXPO_PUBLIC_DEVICE_NAME": "farm-foreman-phone"
      }
    }
  },
  "submit": {
    "production": {}
  }
}