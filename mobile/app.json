{
  "expo": {
    "name": "Glen Oak",
    "slug": "glen-oak",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Glen Oak to scan worker badges and row labels."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Glen Oak to securely access saved sign-in credentials."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a5f4a"
    },
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a5f4a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.glenoaksupplements"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Glen Oak Farm",
      "shortName": "Glen Oak",
      "description": "Glen Oak Farm operations",
      "themeColor": "#1a5f4a",
      "backgroundColor": "#f4f7f3",
      "display": "standalone",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e09eb6fd-369c-4006-a6e7-7705d9e32b34"
      }
    },
    "owner": "bjackson2"
  }
}
